{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness (Bun Edition)",
  "version": "0.2.1",
  "identifier": "ai.deepseek.harness.bun",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#09090b",
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/dsh-bun"
    ],
    "resources": [
      "binaries/web-dist/**/*"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
